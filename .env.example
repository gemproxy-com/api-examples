# Copy to .env and fill in. Never commit .env.
# API token: dashboard > API Documentation > API Keys (https://app.gemproxy.com/api-docs#keys)
GEMPROXY_TOKEN=
# A rotating key you own: dashboard > Rotating Keys (https://app.gemproxy.com/rotating-keys)
GEMPROXY_KEY=
# Optional, defaults to https://api.gemproxy.com
# GEMPROXY_API=https://api.gemproxy.com
